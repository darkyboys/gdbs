


cli:
    --list-dir = "ls"

ontriggerchange:
    command = "echo hi"

onchange:
    commands = ["echo \"Process finished!\"", "ls"]

example/a.cc:
example/b.cc: 
    expanded_compare = "example"
    expanded_compare_ignore = ["example/build.gdbs", "example/a.cc"]
example/c.cc: compare = "example/a.cc"